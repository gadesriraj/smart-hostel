# Smart Hostel Management Platform - Backend Environment Config
PROJECT_NAME="Smart Hostel Management Platform"
API_V1_STR="/api"
SECRET_KEY="replace_with_a_secure_random_64_character_secret_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL / Supabase Connection URI
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hostel_db"

# Server Host and Port
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
